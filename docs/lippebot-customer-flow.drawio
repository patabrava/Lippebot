        <mxCell id="8" value="Ja: Sofort 112 und die LIPPE-Servicenummer anzeigen.&#xa;Noch keine automatische CRM-Änderung." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="390" height="95" as="geometry"/></mxCell>
        <mxCell id="9" value="Nein: Sarah sammelt nur die noch fehlenden Angaben" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="960" y="560" width="340" height="75" as="geometry"/></mxCell>
