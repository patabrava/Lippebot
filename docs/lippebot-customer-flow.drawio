        <mxCell id="6" value="Ja: Sarah beantwortet die Frage.&#xa;Keine Weiterleitung, kein CRM-Eintrag." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="260" width="360" height="90" as="geometry"/></mxCell>
